# Production Environment Configuration
# Copy this file to .env.production and fill in your production credentials

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google reCAPTCHA v3 Configuration - PRODUCTION
# Use a production-specific site key configured with:
# - Your production domain (e.g., thinkzo.ai)
# - Any staging/preview domains (e.g., preview.thinkzo.ai)
# Get your site key from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_production_recaptcha_site_key
