# Development Environment Configuration
# Copy this file to .env.development and fill in your development credentials

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google reCAPTCHA v3 Configuration - DEVELOPMENT
# Use a development-specific site key configured with:
# - localhost
# - 127.0.0.1
# - Any local development domains
# Get your site key from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_development_recaptcha_site_key
